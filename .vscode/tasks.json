{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "micropythonPort",
            "type": "promptString",
            "description": "Serial port for the MicroPython device",
            "default": "COM3"
        }
    ],
    "tasks": [
        {
            "label": "Push Code (Windows)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\sync_to_device.ps1",
                "-Port",
                "${input:micropythonPort}",
                "-WorkspaceRoot",
                "${workspaceFolder}"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}